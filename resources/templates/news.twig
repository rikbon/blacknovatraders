{% extends "layout.twig" %}
{% block title %}BlackNova Network (BNN) - Interstellar Newsfeed{% endblock %}
{% block content %}
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <img src="images/bnnhead.gif" width="220" height="87" alt="The BlackNova Network" style="border-radius: 8px; filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.3));">
            <div>
                <h2 style="color: var(--cyan); margin: 0 0 4px 0; font-size: 1.4rem;">BlackNova News Network</h2>
                <div style="font-size: 12.5px; color: var(--text-muted);">
                    Galactic News Broadcast &bull; Edition for <strong style="color: #fff;">{{ startdate|date('Y-m-d') }}</strong>
                </div>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <a href="news.php?startdate={{ previousday|date('Y-m-d') }}" class="btn" style="font-size: 12px; padding: 6px 12px;">
                &laquo; {{ tr.l_news_prev ?? 'Previous Cycle' }}
            </a>
            <a href="news.php?startdate={{ nextday|date('Y-m-d') }}" class="btn" style="font-size: 12px; padding: 6px 12px;">
                {{ tr.l_news_next ?? 'Next Cycle' }} &raquo;
            </a>
        </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px;">
        {% if news is empty %}
            <div style="background: rgba(15, 23, 42, 0.6); padding: 32px; border-radius: 10px; border: 1px solid var(--border-subtle); text-align: center;">
                <div style="font-size: 1.2rem; color: var(--cyan); margin-bottom: 8px;">No High-Priority Incidents Reported</div>
                <p style="color: var(--text-muted); font-size: 13.5px; max-width: 500px; margin: 0 auto;">
                    {{ tr.l_news_none ?? 'No major space battles, planetary conquests, or corporate disputes were recorded across known sectors during this cycle.' }}
                </p>
            </div>
        {% else %}
            {% for newsItem in news %}
                <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 16px 20px; transition: transform 0.15s ease;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                        <span style="font-weight: bold; color: var(--cyan); font-size: 1.1rem;">
                            {{ newsItem.headline }}
                        </span>
                        <span class="badge badge-amber" style="font-size: 11px;">
                            {{ newsItem.news_type|default('Galactic Incident')|upper }}
                        </span>
                    </div>
                    <div style="color: var(--text-main); font-size: 14px; line-height: 1.6;">
                        {{ newsItem.newstext|raw }}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div style="text-align: center; margin-top: 20px;">
        {% if isLogged %}
            <a href="main.php" class="btn">&laquo; Return to Main Menu</a>
        {% else %}
            <a href="index.php">Home</a> |
            <a href="login.php">Login</a> |
            <a href="new.php">Create Player</a> |
            <a href="ranking.php">Rankings</a>
        {% endif %}
    </div>
{% endblock %}
