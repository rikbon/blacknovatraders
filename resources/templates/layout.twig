<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Pragma" content="no-cache">
    <title>{% block title %}BlackNova Traders{% endblock %} - BlackNova Traders</title>
    <style>
        :root {
            --bg-deep: #060913;
            --bg-surface: #0e1526;
            --bg-card: rgba(15, 23, 42, 0.85);
            --bg-card-hover: rgba(30, 41, 59, 0.9);
            --border-subtle: rgba(56, 189, 248, 0.18);
            --border-glow: rgba(56, 189, 248, 0.5);
            --cyan: #38bdf8;
            --cyan-hover: #7dd3fc;
            --emerald: #34d399;
            --amber: #fbbf24;
            --rose: #fb7185;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --font-stack: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: var(--font-stack);
            background-color: var(--bg-deep);
            background-image: 
                radial-gradient(ellipse 80% 50% at 50% -20%, rgba(14, 165, 233, 0.15), transparent 70%),
                radial-gradient(circle at 10% 20%, rgba(56, 189, 248, 0.04) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.05) 0%, transparent 40%),
                url("images/bgoutspace1.gif");
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        a {
            color: var(--cyan);
            text-decoration: none;
            transition: color 0.15s ease, text-shadow 0.15s ease;
        }

        a:hover {
            color: var(--cyan-hover);
            text-shadow: 0 0 8px rgba(56, 189, 248, 0.5);
        }

        /* Container Layout */
        .page-container {
            max-width: 1100px;
            width: 95%;
            margin: 0 auto;
            flex: 1;
            padding: 16px 0 32px 0;
        }

        /* Header Navigation */
        #header {
            margin-bottom: 24px;
        }

        .navbar {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 12px 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
        }

        .navbar-brand img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.25));
            transition: transform 0.2s ease;
        }

        .navbar-brand img:hover {
            transform: scale(1.01);
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 6px 12px;
            font-size: 13.5px;
        }

        .nav-links a {
            padding: 4px 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid transparent;
            transition: all 0.15s ease;
        }

        .nav-links a:hover {
            background: rgba(56, 189, 248, 0.12);
            border-color: var(--border-subtle);
        }

        .nav-divider {
            color: var(--text-muted);
            opacity: 0.4;
        }

        /* Cards & Content */
        #content {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            margin-bottom: 24px;
        }

        h1, h2, h3, h4 {
            color: var(--text-main);
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-top: 0;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 8px;
        }

        h1 { font-size: 1.6rem; color: var(--cyan); }
        h2 { font-size: 1.3rem; }

        /* Modern Tables */
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin: 12px 0;
            font-size: 14px;
        }

        th {
            background: rgba(30, 41, 59, 0.7);
            color: var(--cyan);
            padding: 10px 14px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border-subtle);
        }

        td {
            padding: 8px 12px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        tr:hover td {
            background: rgba(56, 189, 248, 0.04);
        }

        /* Forms & Inputs */
        input[type="text"],
        input[type="password"],
        input[type="number"],
        input[type="email"],
        select,
        textarea {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid var(--border-subtle);
            border-radius: 6px;
            color: var(--text-main);
            padding: 8px 12px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            font-family: inherit;
        }

        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="number"]:focus,
        input[type="email"]:focus,
        select:focus,
        textarea:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.25);
        }

        input[type="submit"],
        input[type="reset"],
        button,
        .btn {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 6px;
            padding: 8px 18px;
            font-size: 13.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: all 0.15s ease;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
            margin: 4px;
        }

        input[type="submit"]:hover,
        button:hover,
        .btn:hover {
            background: linear-gradient(135deg, #0369a1, #0284c7);
            border-color: var(--cyan);
            box-shadow: 0 0 14px rgba(56, 189, 248, 0.5);
            transform: translateY(-1px);
        }

        input[type="reset"] {
            background: rgba(51, 65, 85, 0.8);
            border-color: rgba(148, 163, 184, 0.3);
            box-shadow: none;
        }

        input[type="reset"]:hover {
            background: rgba(71, 85, 105, 0.9);
            box-shadow: 0 0 8px rgba(148, 163, 184, 0.3);
        }

        /* Status & Badges */
        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-cyan { background: rgba(56, 189, 248, 0.15); color: var(--cyan); border: 1px solid rgba(56, 189, 248, 0.3); }
        .badge-emerald { background: rgba(52, 211, 153, 0.15); color: var(--emerald); border: 1px solid rgba(52, 211, 153, 0.3); }
        .badge-amber { background: rgba(251, 191, 36, 0.15); color: var(--amber); border: 1px solid rgba(251, 191, 36, 0.3); }

        /* Game Entity Sprites */
        .planettypes-0 { width: 80px; height: 90px; background-image: url("images/tinyplanet.gif"); background-repeat: no-repeat; }
        .planettypes-1 { width: 80px; height: 90px; background-image: url("images/smallplanet.gif"); background-repeat: no-repeat; }
        .planettypes-2 { width: 80px; height: 90px; background-image: url("images/mediumplanet.gif"); background-repeat: no-repeat; }
        .planettypes-3 { width: 80px; height: 90px; background-image: url("images/largeplanet.gif"); background-repeat: no-repeat; }
        .planettypes-4 { width: 80px; height: 90px; background-image: url("hugeplanet.gif"); background-repeat: no-repeat; }

        .shiptypes-0 { width: 80px; height: 60px; background-image: url("images/tinyship.gif"); background-repeat: no-repeat; }
        .shiptypes-1 { width: 80px; height: 60px; background-image: url("images/smallship.gif"); background-repeat: no-repeat; }
        .shiptypes-2 { width: 80px; height: 60px; background-image: url("images/mediumship.gif"); background-repeat: no-repeat; }
        .shiptypes-3 { width: 80px; height: 60px; background-image: url("images/largeship.gif"); background-repeat: no-repeat; }
        .shiptypes-4 { width: 80px; height: 60px; background-image: url("images/hugeship.gif"); background-repeat: no-repeat; }

        .space_station_port { width: 100px; height: 70px; background-image: url("images/space_station_port.png"); background-repeat: no-repeat; }
        .space_station { width: 233px; height: 300px; background-image: url("images/space_station.png"); background-repeat: no-repeat; }
        
        .sectordefencetypes-m { width: 80px; height: 60px; background-image: url("images/mines.gif"); background-repeat: no-repeat; }
        .sectordefencetypes-f { width: 80px; height: 60px; background-image: url("images/fighters.gif"); background-repeat: no-repeat; }

        /* Footer */
        #footer {
            border-top: 1px solid var(--border-subtle);
            padding: 16px 0;
            font-size: 12px;
            color: var(--text-muted);
            text-align: center;
            background: rgba(6, 9, 19, 0.8);
            margin-top: auto;
        }

        #footer a {
            color: var(--text-muted);
        }

        #footer a:hover {
            color: var(--cyan);
        }

        /* Responsive utilities */
        @media (max-width: 768px) {
            .page-container { width: 98%; padding: 8px 0; }
            #content { padding: 14px; }
            .nav-links { font-size: 12px; }
        }
    </style>
</head>
<body>
    <div class="page-container">
        <div id="header">
            <div class="navbar">
                <div class="navbar-brand">
                    <a href="index.php"><img src="images/BNT-header.jpg" alt="BlackNova Traders" width="517" height="189" border="0"></a>
                </div>
                <div class="nav-links">
                    {% if isLogged %}
                        <a href="main.php" style="color: var(--emerald); font-weight: bold;">Main Menu</a>
                        <span class="nav-divider">|</span>
                        <a href="device.php">{{ tr.l_devices }}</a>
                        <a href="planet_report2.php">{{ tr.l_planets }}</a>
                        <a href="log2.php">{{ tr.l_log }}</a>
                        <a href="defence_report.php">{{ tr.l_sector_def }}</a>
                        <a href="readmail.php">{{ tr.l_read_msg }}</a>
                        <a href="mailto2.php">{{ tr.l_send_msg }}</a>
                        <a href="ranking.php">{{ tr.l_rankings }}</a>
                        <a href="settings.php">Settings</a>
                        <a href="teams.php">{{ tr.l_teams }}</a>
                        <a href="self_destruct.php" style="color: var(--rose);">{{ tr.l_ohno }}</a>
                        <a href="options.php">{{ tr.l_options }}</a>
                        <a href="navcomp.php">{{ tr.l_navcomp }}</a>
                        {% if ksm_allowed %}
                            <a href="galaxy.php">{{ tr.l_map }}</a>
                        {% endif %}
                        <span class="nav-divider">|</span>
                        <a href="help2.php">{{ tr.l_help }}</a>
                        <a href="news2.php">{{ tr.l_news ?? 'News' }}</a>
                        <a href="faq.html">{{ tr.l_faq }}</a>
                        <a href="feedback.php">{{ tr.l_feedback }}</a>
                        <span class="nav-divider">|</span>
                        <a href="logout.php" style="color: var(--amber);">{{ tr.l_logout }}</a>
                    {% else %}
                        <a href="index.php">Home</a>
                        <a href="login.php">Login</a>
                        <a href="new.php" style="color: var(--emerald); font-weight: bold;">Create Player</a>
                        <a href="ranking.php">Rankings</a>
                        <a href="settings.php">Game Settings</a>
                        <a href="help2.php">Help</a>
                        <a href="news2.php">News</a>
                        <a href="faq.html">FAQ</a>
                    {% endif %}
                </div>
            </div>
        </div>
        <div id="content">
            {% block content %}{% endblock %}
        </div>
    </div>
    <div id="footer">
        <div class="page-container" style="padding: 0;">
            Copyright 2000-2005 Ron Harwood and L. Patrick Smallwood. Copyright 2005-2026 <a href="http://www.sourceforge.net/projects/blacknova">BlackNova Team</a> | Powered by Modern PHP 8.2 & Twig
        </div>
    </div>
</body>
</html>
