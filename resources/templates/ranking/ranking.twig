{% extends "layout.twig" %}
{% block title %}{{ tr.l_ranks_title }}{% endblock %}
{% block content %}
    <h2 style="color: var(--cyan); margin-bottom: 20px;">Galactic Leaderboards &amp; Rankings</h2>

    <div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
        <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 10px; border: 1px solid var(--border-subtle);">
            <h3 style="color: var(--emerald); font-size: 1.15rem; margin-bottom: 12px;">Top Commanders by {{ tr.l_score }}</h3>
            <table>
                <thead>
                    <tr>
                        <th>{{ tr.l_player }}</th>
                        <th>{{ tr.l_score }}</th>
                        <th>Efficiency</th>
                        <th>{{ tr.l_team_alliance }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ship in shipsAsTopScore %}
                        <tr>
                            <td><strong style="color: var(--cyan);">{{ ship.name() }}</strong></td>
                            <td><span class="badge badge-emerald">{{ ship.score() }}</span></td>
                            <td>{{ ship.efficiency() }}%</td>
                            <td>{{ ship.team() ?: '-' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No commanders recorded yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 10px; border: 1px solid var(--border-subtle);">
            <h3 style="color: var(--amber); font-size: 1.15rem; margin-bottom: 12px;">Most Active Commanders ({{ tr.l_turns_used }})</h3>
            <table>
                <thead>
                    <tr>
                        <th>{{ tr.l_player }}</th>
                        <th>{{ tr.l_turns_used }}</th>
                        <th>Efficiency</th>
                        <th>{{ tr.l_team_alliance }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ship in shipsAsTopScore %}
                        <tr>
                            <td><strong style="color: var(--cyan);">{{ ship.name() }}</strong></td>
                            <td><span class="badge badge-amber">{{ ship.turnsUsed() }}</span></td>
                            <td>{{ ship.efficiency() }}%</td>
                            <td>{{ ship.team() ?: '-' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No turns recorded yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 10px; border: 1px solid var(--border-subtle);">
            <h3 style="color: var(--cyan); font-size: 1.15rem; margin-bottom: 12px;">{{ tr.l_ranks_good }} (Honor Rating)</h3>
            <table>
                <thead>
                    <tr>
                        <th>{{ tr.l_player }}</th>
                        <th>{{ tr.l_rating }}</th>
                        <th>Efficiency</th>
                        <th>{{ tr.l_team_alliance }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ship in shipsAsTopRating %}
                        <tr>
                            <td><strong style="color: var(--cyan);">{{ ship.name() }}</strong></td>
                            <td><span class="badge badge-cyan">{{ ship.rating() }}</span></td>
                            <td>{{ ship.efficiency() }}%</td>
                            <td>{{ ship.team() ?: '-' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No honor ratings recorded yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 24px; text-align: center;">
        {% if isLogged %}
            <a href="main.php" class="btn">&laquo; Return to Main Menu</a>
        {% else %}
            <a href="index.php">Home</a> |
            <a href="login.php">Login</a> |
            <a href="new.php">Create Player</a>
        {% endif %}
    </div>
{% endblock %}
